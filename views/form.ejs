<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="container">
        <header class="header-section">
            <h1>New Message</h1>
        </header>

        <div class="form-card">
            <form method="POST" action="/new">
                <fieldset>
                    <div class="form-group">
                        <label for="first_name">Author Name</label>
                        <input type="text" id="first_name" name="name1" placeholder="e.g. Bruce Wayne" required />
                    </div>

                    <div class="form-group">
                        <label for="msg">Message</label>
                        <input type="text" id="msg" name="msg1" placeholder="What's on your mind?" required />
                    </div>
                </fieldset>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Create Message</button>
                    <a href="/" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>